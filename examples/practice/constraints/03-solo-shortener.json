  "id": "solo-shortener",
  "title": "一個人顧的短網址",
  "text": "1 人，一週上線。每秒 4000 個請求，95% 是讀取。現在的資料庫撐不住，一成以上的請求失敗。整場失敗率 ≤ 1%、p99 ≤ 200 ms，每月不超過 $2,800，複雜度不超過 6 點：一個人顧不了讀副本。",
  "example": "url-shortener",
  "scenario": {
    "schema": "loadsketch/scenario@1",
    "name": "限制：每秒 4000",
    "seed": 1,
    "durationS": 60,
    "warmupS": 5,
    "traffic": {
      "rps": 4000,
      "readRatio": 0.95
    }
  },
  "start": [],
  "limits": {
    "maxErrorRate": 0.01,
    "maxP99Ms": 200,
    "budgetPerMonth": 2800,
    "maxPoints": 6
