{
  "schema": "loadsketch/brief@1",
  "id": "example-brief",
  "title": "Brief: async notification service",
  "text": "2-person team, three weeks. Accept notification requests and deliver them through an external SMS provider already on the canvas.",
  "functional": [
    "Callers can submit an SMS via the API",
    "Every submitted message is delivered to the external SMS provider"
  ],
  "load": [
    "500 requests per second, all writes",
    "Callers wait at most 100 ms for the API response"
  ],
  "given": [
    "The external SMS provider takes 200 ms on average and cannot be changed",
    "Your API takes 5 ms per request on average",
    "Workers take 2 ms per message plus provider wait time"
  ],
  "outOfScope": [
    "Message templates and formatting",
    "Delivery receipts"
  ],
  "scenario": {
    "schema": "loadsketch/scenario@1",
    "name": "Brief: example",
    "seed": 1,
    "durationS": 60,
    "warmupS": 5,
    "traffic": {
      "rps": 500,
      "readRatio": 0
    }
  },
  "limits": {
    "maxErrorRate": 0.01,
    "maxP99Ms": 100,
    "budgetPerMonth": 2600,
    "maxPoints": 6
  },
  "start": {
    "schema": "loadsketch/design@1",
    "name": "Brief: example",
    "nodes": [
      {
        "id": "users",
        "kind": "client",
        "label": "Users",
        "pos": [0, 200]
      },
      {
        "id": "sms",
        "kind": "service",
        "label": "SMS provider (external)",
        "pos": [0, 380],
        "params": {
          "instances": 1,
          "concurrency": 400,
          "serviceMs": {
            "mean": 200,
            "cv": 0.5
          },
          "queueLimit": 2000
        }
      }
    ],
    "edges": []
  },
  "fixed": [
    "sms"
  ],
  "needs": [
    {
      "kind": "reaches-node",
      "node": "sms",
      "text": "Messages reach the SMS provider"
    },
    {
      "kind": "finished"
    },
    {
      "kind": "not-degraded"
    }
  ],
  "floors": {
    "worker": {
      "serviceMs": 2
    }
  },
  "hint": "Decouple API ingestion from delivery with a queue and workers sized above 500/s * 0.2 s = 100 concurrent calls.",
  "reference": {
    "schema": "loadsketch/design@1",
    "name": "Brief: example",
    "nodes": [
      {
        "id": "users",
        "kind": "client",
        "label": "Users",
        "pos": [0, 200]
      },
      {
        "id": "lb",
        "kind": "load_balancer",
        "label": "Load Balancer",
        "pos": [200, 200]
      },
      {
        "id": "api",
        "kind": "service",
        "label": "Notification API",
        "pos": [400, 200]
      },
      {
        "id": "outbox",
        "kind": "queue",
        "label": "Outbox Queue",
        "pos": [600, 200]
      },
      {
        "id": "sender",
        "kind": "worker",
        "label": "SMS Worker",
        "pos": [810, 200],
        "params": {
          "instances": 4,
          "concurrency": 32,
          "serviceMs": {
            "mean": 2,
            "cv": 1
          }
        }
      },
      {
        "id": "sms",
        "kind": "service",
        "label": "SMS provider (external)",
        "pos": [1080, 200],
        "params": {
          "instances": 1,
          "concurrency": 400,
          "serviceMs": {
            "mean": 200,
            "cv": 0.5
          },
          "queueLimit": 2000
        }
      }
    ],
    "edges": [
      { "from": "users", "to": "lb" },
      { "from": "lb", "to": "api" },
      { "from": "api", "to": "outbox" },
      { "from": "outbox", "to": "sender" },
      { "from": "sender", "to": "sms" }
    ]
  },
  "naive": {
    "schema": "loadsketch/design@1",
    "name": "Brief: example",
    "nodes": [
      {
        "id": "users",
        "kind": "client",
        "label": "Users",
        "pos": [0, 200]
      },
      {
        "id": "api",
        "kind": "service",
        "label": "Notification API",
        "pos": [540, 200],
        "params": {
          "instances": 4
        }
      },
      {
        "id": "sms",
        "kind": "service",
        "label": "SMS provider (external)",
        "pos": [1080, 200],
        "params": {
          "instances": 1,
          "concurrency": 400,
          "serviceMs": {
            "mean": 200,
            "cv": 0.5
          },
          "queueLimit": 2000
        }
      }
