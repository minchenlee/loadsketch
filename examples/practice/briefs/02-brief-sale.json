{
  "schema": "loadsketch/brief@1",
  "id": "brief-sale",
  "title": "需求：限量開賣",
  "text": "3 人團隊，兩個月後有一檔限量開賣。平常流量不大，開賣的 15 秒會暴增。訂單要寫進公司共用的資料庫，它已經在畫布上。",
  "functional": [
    "使用者能看商品",
    "使用者能下單；下了單就不能掉"
  ],
  "load": [
    "平常每秒 800 個請求，一半是下單（寫入）",
    "第 20 秒開賣：流量變成 16 倍，持續 15 秒"
  ],
  "given": [
    "共用的資料庫有 50 條連線，讀一筆 3 ms、寫一筆 10 ms；它不歸你管，改不了",
    "你的程式處理一個請求平均 5 ms",
    "背景工作處理一筆訂單 2 ms，再加上寫資料庫的時間"
  ],
  "outOfScope": [
    "付款",
    "庫存扣到負數的問題",
    "排隊頁面"
  ],
  "scenario": {
    "schema": "loadsketch/scenario@1",
    "name": "需求：限量開賣",
    "seed": 1,
    "durationS": 120,
    "warmupS": 5,
    "traffic": {
      "rps": 800,
      "readRatio": 0.5
    },
    "events": [
      {
        "type": "spike",
        "atS": 20,
        "forS": 15,
        "multiplier": 16
      }
    ]
  },
  "limits": {
    "maxErrorRate": 0.01,
    "maxP99Ms": 300,
    "budgetPerMonth": 4000,
    "maxPoints": 8
  },
  "start": {
    "schema": "loadsketch/design@1",
    "name": "需求：限量開賣",
    "nodes": [
      {
        "id": "users",
        "kind": "client",
        "label": "使用者",
        "pos": [
          0,
          200
        ]
      },
      {
        "id": "db",
        "kind": "database",
        "label": "公司共用的資料庫",
        "pos": [
          0,
          380
        ]
      }
    ],
    "edges": []
  },
  "fixed": [
    "db"
  ],
  "needs": [
    {
      "kind": "reaches-node",
      "node": "db",
      "text": "訂單有寫進共用的資料庫"
    },
    {
      "kind": "looked"
    },
    {
      "kind": "finished"
    },
    {
      "kind": "not-degraded"
    }
  ],
  "floors": {
    "worker": {
      "serviceMs": 2
    }
  },
  "hint": "開賣時每秒 6,400 筆寫入 × 10 ms = 64 條連線，再加上讀取約 19 條，共用的資料庫只有 50 條，而且改不了。下單可以先進佇列就回應，背景工作再照資料庫吃得下的速度寫進去：尖峰被攤平，只要結束前做得完。背景工作的同時處理數就是它最多佔用的連線數，要留一些給讀取。API Server 也要撐得住尖峰：每秒 12,800 個請求。",
  "reference": {
    "schema": "loadsketch/design@1",
    "name": "需求：限量開賣",
    "nodes": [
      {
        "id": "users",
        "kind": "client",
