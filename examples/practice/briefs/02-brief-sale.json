{
  "schema": "loadsketch/brief@1",
  "id": "brief-sale",
  "title": "Brief: limited sale",
  "text": "A team of 3, a limited sale in two months. Traffic is low most of the time and jumps for the 15 seconds of the sale. Orders go into the company's shared database; it is on the canvas already.",
  "functional": [
    "Users can view products",
    "Users can place an order; a placed order must not be lost"
  ],
  "load": [
    "800 requests a second most of the time; half are orders (writes)",
    "The sale opens at second 20: traffic is 16 times higher for 15 seconds"
  ],
  "given": [
    "The shared database has 50 connections, a read takes 3 ms and a write 10 ms; it is not yours, so you cannot change it",
    "Your code takes 5 ms on average for one request",
    "A worker takes 2 ms for one order, plus the database write"
  ],
  "outOfScope": ["Payment", "Stock going below zero", "A waiting-room page"],
  "scenario": {
    "schema": "loadsketch/scenario@1",
    "name": "Brief: limited sale",
    "seed": 1,
    "durationS": 120,
    "warmupS": 5,
    "traffic": { "rps": 800, "readRatio": 0.5 },
    "events": [{ "type": "spike", "atS": 20, "forS": 15, "multiplier": 16 }]
  },
  "limits": { "maxErrorRate": 0.01, "maxP99Ms": 300, "budgetPerMonth": 4000, "maxPoints": 8 },
  "start": {
    "schema": "loadsketch/design@1",
    "name": "Brief: limited sale",
    "nodes": [
      { "id": "users", "kind": "client", "label": "Users", "pos": [0, 200] },
      { "id": "db", "kind": "database", "label": "Shared database", "pos": [0, 380] }
    ],
    "edges": []
  },
  "fixed": ["db"],
  "needs": [
    { "kind": "reaches-node", "node": "db", "text": "Orders are written to the shared database" },
    { "kind": "looked" },
    { "kind": "finished" },
    { "kind": "not-degraded" }
  ],
  "floors": { "worker": { "serviceMs": 2 } },
  "hint": "During the sale, 6,400 writes a second × 10 ms = 64 connections, plus about 19 for reads; the shared database has 50 and you cannot change it. An order can go on a queue and be answered at once, and workers write it at a rate the database can take: the peak is spread out, as long as the work is finished before the end. The workers' concurrency is the most connections they use, so leave some for reads. The API Servers must hold the peak too: 12,800 requests a second.",
  "reference": {
    "schema": "loadsketch/design@1",
    "name": "Brief: limited sale",
    "nodes": [
      { "id": "users", "kind": "client", "label": "Users", "pos": [0, 200] },
      { "id": "lb", "kind": "load_balancer", "label": "Load balancer", "pos": [270, 200] },
      {
        "id": "api",
        "kind": "service",
        "label": "Shop API",
        "pos": [540, 200],
        "params": { "instances": 6 }
      },
      { "id": "orders", "kind": "queue", "label": "Order queue", "pos": [810, 80] },
      {
        "id": "writer",
        "kind": "worker",
        "label": "Order writer (worker)",
        "pos": [1080, 80],
        "params": { "instances": 3, "concurrency": 10, "serviceMs": { "mean": 2, "cv": 1 } }
      },
      { "id": "db", "kind": "database", "label": "Shared database", "pos": [1080, 320] }
    ],
    "edges": [
      { "from": "users", "to": "lb" },
      { "from": "lb", "to": "api" },
      { "from": "api", "to": "orders", "on": "write" },
      { "from": "orders", "to": "writer" },
      { "from": "writer", "to": "db" },
      { "from": "api", "to": "db", "on": "read" }
    ]
  },
  "naive": {
    "schema": "loadsketch/design@1",
    "name": "Brief: limited sale",
    "nodes": [
      { "id": "users", "kind": "client", "label": "Users", "pos": [0, 200] },
      { "id": "lb", "kind": "load_balancer", "label": "Load balancer", "pos": [270, 200] },
      {
        "id": "api",
        "kind": "service",
        "label": "Shop API",
        "pos": [540, 200],
        "params": { "instances": 6 }
      },
      { "id": "db", "kind": "database", "label": "Shared database", "pos": [1080, 320] }
    ],
    "edges": [
      { "from": "users", "to": "lb" },
      { "from": "lb", "to": "api" },
      { "from": "api", "to": "db" }
    ]
  }
}
