        "kind": "load_balancer",
        "label": "負載平衡器",
        "pos": [
          270,
          200
        ]
      },
      {
        "id": "api",
        "kind": "service",
        "label": "商店 API",
        "pos": [
          540,
          200
        ],
        "params": {
          "instances": 6
        }
      },
      {
        "id": "orders",
        "kind": "queue",
        "label": "訂單佇列",
        "pos": [
          810,
          80
        ]
      },
      {
        "id": "writer",
        "kind": "worker",
        "label": "寫訂單的背景工作",
        "pos": [
          1080,
          80
        ],
        "params": {
          "instances": 3,
          "concurrency": 10,
          "serviceMs": {
            "mean": 2,
            "cv": 1
          }
        }
      },
      {
        "id": "db",
        "kind": "database",
        "label": "公司共用的資料庫",
        "pos": [
