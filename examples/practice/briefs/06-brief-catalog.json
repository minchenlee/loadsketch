{
  "schema": "loadsketch/brief@1",
  "id": "brief-catalog",
  "title": "Brief: product page",
  "text": "A team of 2, one month. The product page shows the stock. The stock is in a very old database; it is on the canvas already: slow, with few connections, and nobody dares to touch it.",
  "functional": [
    "Users can see the stock of a product",
    "The stock number can be a few seconds old"
  ],
  "load": ["3,000 requests a second, all reads"],
  "given": [
    "The old stock database takes 40 ms on average for one read and has only 20 connections; you cannot change these",
    "Your code takes 5 ms on average for one request",
    "The cache hit ratio is 90% at most"
  ],
  "outOfScope": [
    "Moving off the old database",
    "Reducing the stock",
    "A stock number that is exact at every moment"
  ],
  "scenario": {
    "schema": "loadsketch/scenario@1",
    "name": "Brief: product page",
    "seed": 1,
    "durationS": 60,
    "warmupS": 5,
    "traffic": { "rps": 3000, "readRatio": 1 }
  },
  "limits": { "maxErrorRate": 0.01, "maxP99Ms": 150, "budgetPerMonth": 2000, "maxPoints": 6 },
  "start": {
    "schema": "loadsketch/design@1",
    "name": "Brief: product page",
    "nodes": [
      { "id": "users", "kind": "client", "label": "Users", "pos": [0, 200] },
      {
        "id": "stock",
        "kind": "database",
        "label": "Stock database (old)",
        "pos": [0, 380],
        "params": { "connections": 20, "readMs": { "mean": 40, "cv": 0.5 } }
      }
    ],
    "edges": []
  },
  "fixed": ["stock"],
  "needs": [
    {
      "kind": "reaches-node",
      "node": "stock",
      "text": "The stock comes from the old database",
      "op": "calls",
      "share": 0.05
    },
    { "kind": "not-degraded" }
  ],
  "hint": "The old database has 20 connections and one read takes 40 ms: at most 500 reads a second. You have 3,000 requests. You cannot change it, so it must get fewer: \"a few seconds old\" means a cache is allowed. The API asks the cache first and reads the old database only on a miss (API → cache, API → old database). The cache answers nine requests in ten, and the old database gets only 300 a second.",
  "reference": {
    "schema": "loadsketch/design@1",
    "name": "Brief: product page",
    "nodes": [
      { "id": "users", "kind": "client", "label": "Users", "pos": [0, 200] },
      { "id": "lb", "kind": "load_balancer", "label": "Load balancer", "pos": [270, 200] },
      {
        "id": "api",
        "kind": "service",
        "label": "Product API",
        "pos": [540, 200],
        "params": { "instances": 3 }
      },
      { "id": "cache", "kind": "cache", "label": "Stock cache", "pos": [810, 80] },
      {
        "id": "stock",
        "kind": "database",
        "label": "Stock database (old)",
        "pos": [810, 320],
        "params": { "connections": 20, "readMs": { "mean": 40, "cv": 0.5 } }
      }
    ],
    "edges": [
      { "from": "users", "to": "lb" },
      { "from": "lb", "to": "api" },
      { "from": "api", "to": "cache" },
      { "from": "api", "to": "stock" }
    ]
  },
  "naive": {
    "schema": "loadsketch/design@1",
    "name": "Brief: product page",
    "nodes": [
      { "id": "users", "kind": "client", "label": "Users", "pos": [0, 200] },
      { "id": "lb", "kind": "load_balancer", "label": "Load balancer", "pos": [270, 200] },
      {
        "id": "api",
        "kind": "service",
        "label": "Product API",
        "pos": [540, 200],
        "params": { "instances": 3 }
      },
      {
        "id": "stock",
        "kind": "database",
        "label": "Stock database (old)",
        "pos": [810, 320],
        "params": { "connections": 20, "readMs": { "mean": 40, "cv": 0.5 } }
      }
    ],
    "edges": [
      { "from": "users", "to": "lb" },
      { "from": "lb", "to": "api" },
      { "from": "api", "to": "stock" }
    ]
  }
}
