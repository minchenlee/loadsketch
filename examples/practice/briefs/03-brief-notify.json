{
  "schema": "loadsketch/brief@1",
  "id": "brief-notify",
  "title": "需求：簡訊通知",
  "text": "2 人團隊，三週。其他團隊呼叫你的 API，你負責把簡訊送出去。簡訊由外部供應商發送，已經在畫布上。",
  "functional": [
    "其他服務能呼叫 API 送出一則簡訊",
    "每一則都要真的送到簡訊供應商"
  ],
  "load": [
    "每秒 500 則，全部是寫入",
    "呼叫你的服務只等得了 100 ms：API 要很快回應"
  ],
  "given": [
    "簡訊供應商送一則平均 200 ms，這個改不了",
    "你的 API 處理一個請求平均 5 ms",
    "背景工作處理一則 2 ms，再加上等供應商的時間"
  ],
  "outOfScope": [
    "簡訊內容和範本",
    "供應商出錯時的重送",
    "送達回報"
  ],
  "scenario": {
    "schema": "loadsketch/scenario@1",
    "name": "需求：簡訊通知",
    "seed": 1,
    "durationS": 60,
    "warmupS": 5,
    "traffic": {
      "rps": 500,
      "readRatio": 0
    }
  },
  "limits": {
    "maxErrorRate": 0.01,
    "maxP99Ms": 100,
    "budgetPerMonth": 2600,
    "maxPoints": 6
  },
  "start": {
    "schema": "loadsketch/design@1",
    "name": "需求：簡訊通知",
    "nodes": [
      {
        "id": "users",
        "kind": "client",
        "label": "使用者",
        "pos": [
          0,
          200
        ]
      },
      {
        "id": "sms",
        "kind": "service",
        "label": "簡訊供應商（外部）",
        "pos": [
          0,
          380
        ],
        "params": {
          "instances": 1,
          "concurrency": 400,
          "serviceMs": {
            "mean": 200,
            "cv": 0.5
          },
          "queueLimit": 2000
        }
      }
    ],
    "edges": []
  },
  "fixed": [
    "sms"
  ],
  "needs": [
    {
      "kind": "reaches-node",
      "node": "sms",
      "text": "簡訊有送到供應商"
    },
    {
      "kind": "finished"
    },
    {
      "kind": "not-degraded"
    }
  ],
  "floors": {
    "worker": {
      "serviceMs": 2
    }
  },
  "hint": "API 直接呼叫供應商，每個請求就要等 200 ms，不可能在 100 ms 內回應。把「收下請求」和「送出簡訊」分開：API 把請求放進佇列就回應，背景工作再去呼叫供應商。每秒 500 則 × 200 ms = 同時有 100 則在送，背景工作的同時處理數加起來要超過 100。",
