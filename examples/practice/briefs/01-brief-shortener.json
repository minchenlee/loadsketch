{
  "schema": "loadsketch/brief@1",
  "id": "brief-shortener",
  "title": "Brief: URL shortener",
  "text": "A team of 2, live in one month. Build a URL shortener.",
  "functional": [
    "Users can turn a long URL into a short one",
    "A user who opens a short URL is sent to the original URL"
  ],
  "load": ["20,000 requests a second: 95% open a short URL (reads), 5% create one (writes)"],
  "given": [
    "Your code takes 5 ms on average for one request",
    "A database read takes 3 ms and a write 10 ms",
    "The cache hit ratio is 90% at most"
  ],
  "outOfScope": ["Sign-in and accounts", "Click statistics", "Custom short codes"],
  "scenario": {
    "schema": "loadsketch/scenario@1",
    "name": "Brief: URL shortener",
    "seed": 1,
    "durationS": 30,
    "warmupS": 5,
    "traffic": { "rps": 20000, "readRatio": 0.95 }
  },
  "limits": { "maxErrorRate": 0.01, "maxP99Ms": 100, "budgetPerMonth": 10600, "maxPoints": 6 },
  "start": {
    "schema": "loadsketch/design@1",
    "name": "Brief: URL shortener",
    "nodes": [{ "id": "users", "kind": "client", "label": "Users", "pos": [0, 200] }],
    "edges": []
  },
  "fixed": [],
  "needs": [{ "kind": "stored" }, { "kind": "looked" }, { "kind": "not-degraded" }],
  "hint": "Estimate the capacity first. While the API handles a request it also waits for the cache or the database, so it holds a slot for about 7 ms, not only its own 5 ms. 20,000 requests per second × 7 ms = about 140 in progress at one time; the default 2 instances are not enough. The database: 19,000 reads per second × 3 ms = 57 connections, and 1,000 writes per second × 10 ms = 10 more: 67 in all, and the default is 50. You can make the database larger, or put a cache in front to take 90% of the reads. Work out both; the prices are close.",
  "reference": {
    "schema": "loadsketch/design@1",
    "name": "Brief: URL shortener",
    "nodes": [
      { "id": "users", "kind": "client", "label": "Users", "pos": [0, 200] },
      { "id": "lb", "kind": "load_balancer", "label": "Load balancer", "pos": [270, 200] },
      {
        "id": "api",
        "kind": "service",
        "label": "Redirect API",
        "pos": [540, 200],
        "params": { "instances": 5 }
      },
      {
        "id": "cache",
        "kind": "cache",
        "label": "Cache (code → URL)",
        "pos": [810, 80],
        "params": { "instances": 2 }
      },
      { "id": "db", "kind": "database", "label": "URL database", "pos": [810, 320] }
    ],
    "edges": [
      { "from": "users", "to": "lb" },
      { "from": "lb", "to": "api" },
      { "from": "api", "to": "cache" },
      { "from": "api", "to": "db" }
    ]
  },
  "naive": {
    "schema": "loadsketch/design@1",
    "name": "Brief: URL shortener",
    "nodes": [
      { "id": "users", "kind": "client", "label": "Users", "pos": [0, 200] },
      { "id": "lb", "kind": "load_balancer", "label": "Load balancer", "pos": [270, 200] },
      { "id": "api", "kind": "service", "label": "Redirect API", "pos": [540, 200] },
      { "id": "db", "kind": "database", "label": "URL database", "pos": [810, 200] }
    ],
    "edges": [
      { "from": "users", "to": "lb" },
      { "from": "lb", "to": "api" },
      { "from": "api", "to": "db" }
    ]
  }
}
