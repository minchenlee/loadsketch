{
  "schema": "loadsketch/scenario@1",
  "name": "Load test: traffic 1.25 times in seconds 20–50, and one storage node 10 times slower",
  "seed": 1,
  "durationS": 80,
  "warmupS": 10,
  "traffic": { "rps": 3500, "readRatio": 0.9, "clientTimeoutMs": 2000 },
  "events": [
    { "type": "spike", "atS": 20, "forS": 30, "multiplier": 1.25 },
    { "type": "slow", "atS": 20, "forS": 30, "node": "storage", "instance": 0, "multiplier": 10 }
  ]
}
