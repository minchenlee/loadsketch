{
  "schema": "loadsketch/design@1",
  "name": "Drop bots first under overload (priority load shedding)",
  "description": "Three traffic sources hit the same set of APIs: checkout (critical), browsing (normal) and a crawler bot (batch). Traffic goes 3× at second 20 and the API cannot keep up. The API has a load-shedding threshold of 0.2: when the queue reaches 20% of its limit, it rejects bots first, so checkout and browsing are barely affected. Set the threshold to 0, run again, and compare the failures of the three users.",
  "nodes": [
    {
      "id": "shop",
      "kind": "client",
      "label": "Checkout",
      "pos": [0, 60],
      "params": { "weight": 1, "priority": "critical" }
    },
    {
      "id": "browse",
      "kind": "client",
      "label": "Browse",
      "pos": [0, 220],
      "params": { "weight": 3 }
    },
    {
      "id": "bots",
      "kind": "client",
      "label": "Crawler bot",
      "pos": [0, 380],
      "params": { "weight": 2, "priority": "batch" }
    },
    { "id": "lb", "kind": "load_balancer", "label": "Load balancer", "pos": [340, 220] },
    {
      "id": "api",
      "kind": "service",
      "label": "API server",
      "pos": [640, 220],
      "params": {
        "instances": 2,
        "concurrency": 10,
        "serviceMs": { "mean": 12, "cv": 1 },
        "queueLimit": 300,
        "shedAt": 0.2
      }
    },
    {
      "id": "db",
      "kind": "database",
      "label": "Postgres",
      "pos": [980, 220],
      "params": { "replicas": 1, "connections": 40 }
    }
  ],
  "edges": [
    { "from": "shop", "to": "lb" },
    { "from": "browse", "to": "lb" },
    { "from": "bots", "to": "lb" },
    { "from": "lb", "to": "api" },
    { "from": "api", "to": "db" }
  ]
}
