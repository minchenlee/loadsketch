{
  "schema": "loadsketch/design@1",
  "name": "Thundering herd after the cache restarts cold (after Instagram)",
  "description": "Instagram keeps most data in PostgreSQL (one primary, a replica in each region) and puts memcache in front to absorb reads. When the cache is flushed or expires, all Django servers query the database at once (thundering herd); they solved this with a memcache lease. This model stops the cache for 5 s; it comes back cold, and you can watch the database replicas get flooded.",
  "nodes": [
    { "id": "users", "kind": "client", "label": "Users", "pos": [0, 200] },
    {
      "id": "lb",
      "kind": "load_balancer",
      "label": "Load balancer",
      "pos": [270, 200],
      "params": { "policy": "least_conn" }
    },
    {
      "id": "django",
      "kind": "service",
      "label": "Django",
      "pos": [540, 200],
      "params": {
        "instances": 6,
        "concurrency": 32,
        "serviceMs": { "mean": 5, "cv": 1 },
        "queueLimit": 300
      }
    },
    {
      "id": "memcache",
      "kind": "cache",
      "label": "memcache",
      "pos": [810, 80],
      "params": { "mode": "lru", "capacityKeys": 30000, "instances": 3, "concurrency": 16 }
    },
    {
      "id": "pg",
      "kind": "database",
      "label": "PostgreSQL",
      "pos": [810, 320],
      "params": {
        "replicas": 2,
        "connections": 8,
        "readMs": { "mean": 6, "cv": 1 },
        "writeMs": { "mean": 10, "cv": 1 },
        "queueLimit": 300
      }
    }
  ],
  "edges": [
    { "from": "users", "to": "lb" },
    { "from": "lb", "to": "django" },
    { "from": "django", "to": "memcache" },
    { "from": "django", "to": "pg", "timeoutMs": 500 }
  ]
}
