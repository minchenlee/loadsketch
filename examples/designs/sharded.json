{
  "schema": "loadsketch/design@1",
  "name": "Sharded database and hotspots",
  "description": "When the write volume is too much for one primary, split the data by key into 4 shards. Key popularity is uneven (Zipf), so the hottest key makes one shard extra busy.",
  "nodes": [
    { "id": "users", "kind": "client", "pos": [0, 200] },
    {
      "id": "lb",
      "kind": "load_balancer",
      "label": "Load balancer",
      "pos": [270, 200],
      "params": { "policy": "p2c" }
    },
    {
      "id": "api",
      "kind": "service",
      "label": "API server",
      "pos": [540, 200],
      "params": { "instances": 4, "concurrency": 16 }
    },
    {
      "id": "db",
      "kind": "sharded_db",
      "label": "Sharded database",
      "pos": [860, 200],
      "params": { "shards": 4, "connections": 8, "writeMs": { "mean": 8, "cv": 1 } }
    }
  ],
  "edges": [
    { "from": "users", "to": "lb" },
    { "from": "lb", "to": "api" },
    { "from": "api", "to": "db" }
  ]
}
