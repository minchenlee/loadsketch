{
  "schema": "loadsketch/design@1",
  "name": "Retry storm (metastable failure)",
  "description": "A three-tier site sets a 150 ms timeout and 3 retries on every edge. Traffic goes 3× from second 20 to 30. After the spike traffic returns to normal, but the system never recovers: each request tries 4 times, the API keeps getting about 4× traffic, and everything times out. Try setting the edge retry budget to 0.1, or set retries to 0.",
  "nodes": [
    { "id": "users", "kind": "client", "pos": [0, 200] },
    {
      "id": "lb",
      "kind": "load_balancer",
      "label": "Load balancer",
      "pos": [300, 200],
      "params": { "policy": "least_conn" }
    },
    {
      "id": "api",
      "kind": "service",
      "label": "API server",
      "pos": [590, 200],
      "params": { "instances": 3, "concurrency": 4, "serviceMs": { "mean": 6, "cv": 1 } }
    },
    {
      "id": "cache",
      "kind": "cache",
      "label": "Redis",
      "pos": [920, 80],
      "params": { "hitRatio": 0.85 }
    },
    {
      "id": "db",
      "kind": "database",
      "label": "Postgres",
      "pos": [920, 320],
      "params": { "replicas": 1, "connections": 12 }
    }
  ],
  "edges": [
    { "from": "users", "to": "lb" },
    { "from": "lb", "to": "api", "timeoutMs": 150, "retries": 3, "backoffMs": 10 },
    { "from": "api", "to": "cache", "timeoutMs": 150, "retries": 3, "backoffMs": 10 },
    { "from": "api", "to": "db", "timeoutMs": 150, "retries": 3, "backoffMs": 10 }
  ]
}
