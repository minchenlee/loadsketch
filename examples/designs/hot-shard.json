{
  "schema": "loadsketch/design@1",
  "name": "A hot channel makes a hot shard (after Discord)",
  "description": "Discord splits messages into database partitions by channel (and time range); when a very large server posts an announcement, everyone reads the same channel, so the node that holds that partition becomes a hot spot and slows other queries on the same node. This model uses 8 shards with very concentrated keys, so one shard stays fully busy while the others sit idle.",
  "nodes": [
    { "id": "users", "kind": "client", "label": "Users", "pos": [0, 200] },
    {
      "id": "lb",
      "kind": "load_balancer",
      "label": "Load balancer",
      "pos": [270, 200],
      "params": { "policy": "p2c" }
    },
    {
      "id": "api",
      "kind": "service",
      "label": "API",
      "pos": [540, 200],
      "params": { "instances": 4, "concurrency": 32, "serviceMs": { "mean": 3, "cv": 1 } }
    },
    {
      "id": "data",
      "kind": "service",
      "label": "Data service",
      "pos": [810, 200],
      "params": { "instances": 4, "concurrency": 32, "serviceMs": { "mean": 1, "cv": 1 } }
    },
    {
      "id": "messages",
      "kind": "sharded_db",
      "label": "Message database (sharded)",
      "pos": [1080, 200],
      "params": {
        "shards": 8,
        "connections": 4,
        "readMs": { "mean": 4, "cv": 1 },
        "writeMs": { "mean": 6, "cv": 1 },
        "queueLimit": 300
      }
    }
  ],
  "edges": [
    { "from": "users", "to": "lb" },
    { "from": "lb", "to": "api" },
    { "from": "api", "to": "data" },
    { "from": "data", "to": "messages", "timeoutMs": 1000 }
  ]
}
