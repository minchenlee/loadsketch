{
  "schema": "loadsketch/design@1",
  "name": "Timeline write fan-out (after Twitter)",
  "description": "Twitter pushes the tweet ID into each follower's timeline cache at post time (fan-out on write), so reading a timeline is one cache lookup. The cost is write amplification: posts surge during big events, the fan-out queue backs up, and followers see the tweet a while later. In this model reads go to the cache; posts enter the queue and fan-out workers write them into timeline storage.",
  "nodes": [
    { "id": "users", "kind": "client", "label": "Users", "pos": [0, 200] },
    { "id": "lb", "kind": "load_balancer", "label": "Load balancer", "pos": [270, 200] },
    {
      "id": "api",
      "kind": "service",
      "label": "Timeline API",
      "pos": [540, 200],
      "params": { "instances": 6, "concurrency": 32, "serviceMs": { "mean": 3, "cv": 1 } }
    },
    {
      "id": "tlcache",
      "kind": "cache",
      "label": "Timeline cache (Redis)",
      "pos": [810, 60],
      "params": { "hitRatio": 0.97, "instances": 4, "concurrency": 16 }
    },
    { "id": "fanout", "kind": "queue", "label": "Fan-out queue", "pos": [810, 340] },
    {
      "id": "fanworker",
      "kind": "worker",
      "label": "Fan-out worker",
      "pos": [1080, 340],
      "params": { "instances": 4, "concurrency": 4, "serviceMs": { "mean": 40, "cv": 1 } }
    },
    {
      "id": "timelines",
      "kind": "sharded_db",
      "label": "Timeline storage (sharded)",
      "pos": [1350, 200],
      "params": {
        "shards": 8,
        "connections": 16,
        "readMs": { "mean": 4, "cv": 1 },
        "writeMs": { "mean": 3, "cv": 1 }
      }
    }
  ],
  "edges": [
    { "from": "users", "to": "lb" },
    { "from": "lb", "to": "api" },
    { "from": "api", "to": "tlcache", "on": "read" },
    { "from": "api", "to": "timelines", "on": "read", "timeoutMs": 500 },
    { "from": "api", "to": "fanout", "on": "write" },
    { "from": "fanout", "to": "fanworker" },
    { "from": "fanworker", "to": "timelines" }
  ]
}
