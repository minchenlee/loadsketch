{
  "schema": "loadsketch/design@1",
  "name": "Flash sale: rate limit at the door (after Shopify)",
  "description": "When a popular shop starts selling, checkout traffic jumps within seconds, and every checkout step writes to the database. Shopify once added leaky-bucket throttling at the edge and sent the excess users to a queue page. This model puts a rate limiter in front: extra requests are rejected right away (429), so the checkout service and the database behind it keep a normal pace.",
  "nodes": [
    { "id": "buyers", "kind": "client", "label": "Flash-sale shoppers", "pos": [0, 200] },
    {
      "id": "limiter",
      "kind": "rate_limiter",
      "label": "Edge throttling",
      "pos": [270, 200],
      "params": { "ratePerSec": 1500, "burst": 300 }
    },
    {
      "id": "lb",
      "kind": "load_balancer",
      "label": "Load balancer",
      "pos": [540, 200],
      "params": { "policy": "least_conn" }
    },
    {
      "id": "checkout",
      "kind": "service",
      "label": "Checkout service",
      "pos": [810, 200],
      "params": {
        "instances": 4,
        "concurrency": 16,
        "serviceMs": { "mean": 8, "cv": 1 },
        "queueLimit": 200
      }
    },
    {
      "id": "db",
      "kind": "database",
      "label": "Store database (MySQL)",
      "pos": [1080, 200],
      "params": {
        "replicas": 1,
        "connections": 16,
        "readMs": { "mean": 3, "cv": 1 },
        "writeMs": { "mean": 12, "cv": 1 },
        "queueLimit": 300
      }
    }
  ],
  "edges": [
    { "from": "buyers", "to": "limiter" },
    { "from": "limiter", "to": "lb" },
    { "from": "lb", "to": "checkout" },
    { "from": "checkout", "to": "db", "timeoutMs": 1000 }
  ]
}
