{
  "schema": "loadsketch/design@1",
  "name": "Region evacuation: move the traffic to another region, with a warm cache",
  "description": "Each of two regions has an API and a cache; the database is in the east. DNS first sends all traffic to the east. The scenario moves all of it to the west at 30 s (a traffic shift event). The edges between the two caches are cross-region replication: a cache set or delete on one side is applied to the other after the inter-region latency, so the west cache stays warm. Try it: delete the two edges between the caches and run again. When the west takes over, its hit ratio drops and the database reads jump. Without replication, another way is a longer shift time (for example 20 s): the west takes a small part of the traffic first, and its cache warms up by itself.",
  "nodes": [
    { "id": "users", "kind": "client", "label": "Users", "pos": [0, 250] },
    { "id": "dns", "kind": "dns", "label": "DNS", "pos": [250, 250] },
    {
      "id": "api_e",
      "kind": "service",
      "label": "API (east)",
      "region": "us-east",
      "pos": [500, 100],
      "params": { "instances": 4, "concurrency": 64, "serviceMs": { "mean": 2, "cv": 0.5 } }
    },
    {
      "id": "api_w",
      "kind": "service",
      "label": "API (west)",
      "region": "us-west",
      "pos": [500, 400],
      "params": { "instances": 4, "concurrency": 64, "serviceMs": { "mean": 2, "cv": 0.5 } }
    },
    {
      "id": "cache_e",
      "kind": "cache",
      "label": "Cache (east)",
      "region": "us-east",
      "pos": [780, 100],
      "params": {
        "mode": "lru",
        "capacityKeys": 20000,
        "ttlS": 600,
        "instances": 2,
        "concurrency": 64,
        "opMs": { "mean": 0.3, "cv": 0.5 }
      }
    },
    {
      "id": "cache_w",
      "kind": "cache",
      "label": "Cache (west)",
      "region": "us-west",
      "pos": [780, 400],
      "params": {
        "mode": "lru",
        "capacityKeys": 20000,
        "ttlS": 600,
        "instances": 2,
        "concurrency": 64,
        "opMs": { "mean": 0.3, "cv": 0.5 }
      }
    },
    {
      "id": "db",
      "kind": "database",
      "label": "Database (east)",
      "region": "us-east",
      "pos": [1060, 250],
      "params": {
        "connections": 32,
        "readMs": { "mean": 4, "cv": 0.5 },
        "writeMs": { "mean": 4, "cv": 0.5 }
      }
    }
  ],
  "edges": [
    { "from": "users", "to": "dns" },
    { "from": "dns", "to": "api_e", "weight": 1 },
    { "from": "dns", "to": "api_w", "weight": 0 },
    { "from": "api_e", "to": "cache_e" },
    { "from": "api_e", "to": "db" },
    { "from": "api_w", "to": "cache_w" },
    { "from": "api_w", "to": "db" },
    { "from": "cache_e", "to": "cache_w" },
    { "from": "cache_w", "to": "cache_e" }
  ]
}
