{
  "schema": "loadsketch/design@1",
  "name": "Custom service: external search",
  "description": "The catalog has no search engine, so a \"Custom service\" stands for one: 3 instances, 16 queries at a time each, about 25 ms each, $0.30 per instance per hour. The product API reads Postgres, then calls search (300 ms timeout). Click the search component and change its processing time, instances or price to see how latency and cost change.",
  "nodes": [
    { "id": "users", "kind": "client", "pos": [0, 200] },
    { "id": "lb", "kind": "load_balancer", "label": "Load balancer", "pos": [300, 200] },
    {
      "id": "api",
      "kind": "service",
      "label": "Product API",
      "pos": [590, 200],
      "params": { "instances": 3, "concurrency": 32, "serviceMs": { "mean": 4, "cv": 0.5 } }
    },
    {
      "id": "db",
      "kind": "database",
      "label": "Postgres",
      "pos": [920, 90],
      "params": { "connections": 50 }
    },
    {
      "id": "search",
      "kind": "custom",
      "label": "Search (Elasticsearch)",
      "pos": [920, 320],
      "params": {
        "icon": "Search",
        "instances": 3,
        "concurrency": 16,
        "serviceMs": { "mean": 25, "cv": 0.8 },
        "queueLimit": 200,
        "pricePerHour": 0.3
      }
    }
  ],
  "edges": [
    { "from": "users", "to": "lb" },
    { "from": "lb", "to": "api" },
    { "from": "api", "to": "db", "timeoutMs": 500 },
    { "from": "api", "to": "search", "timeoutMs": 300 }
  ]
}
