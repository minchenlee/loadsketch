{
  "schema": "loadsketch/design@1",
  "name": "Reliable async processing (at-least-once + DLQ)",
  "description": "Same as \"async processing after upload\", but the queue is delete-after-done (like SQS): if a worker fails, the message is not lost and is redelivered after the visibility timeout. 1% are poison messages: after 3 failed receives they move to the DLQ. A message expires if it is not done within 10 minutes.",
  "nodes": [
    { "id": "users", "kind": "client", "pos": [0, 200] },
    { "id": "gw", "kind": "api_gateway", "label": "API Gateway", "pos": [270, 200] },
    {
      "id": "api",
      "kind": "service",
      "label": "Upload API",
      "pos": [540, 200],
      "params": { "instances": 2, "concurrency": 16 }
    },
    { "id": "blob", "kind": "object_storage", "label": "S3", "pos": [840, 60] },
    {
      "id": "jobs",
      "kind": "queue",
      "label": "Work queue",
      "pos": [840, 240],
      "params": {
        "delivery": "at_least_once",
        "visibilityTimeoutMs": 2000,
        "maxReceives": 3,
        "messageTtlS": 600
      }
    },
    {
      "id": "thumb",
      "kind": "worker",
      "label": "Thumbnail worker",
      "pos": [1130, 240],
      "params": {
        "instances": 2,
        "concurrency": 4,
        "serviceMs": { "mean": 40, "cv": 0.5 },
        "poisonRate": 0.01
      }
    },
    { "id": "db", "kind": "database", "label": "Postgres", "pos": [1430, 240] }
  ],
  "edges": [
    { "from": "users", "to": "gw" },
    { "from": "gw", "to": "api" },
    { "from": "api", "to": "blob", "on": "write" },
    { "from": "api", "to": "jobs", "on": "write" },
    { "from": "api", "to": "db", "on": "read" },
    { "from": "jobs", "to": "thumb" },
    { "from": "thumb", "to": "db" }
  ]
}
