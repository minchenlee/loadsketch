{
  "schema": "loadsketch/design@1",
  "name": "Retry budget (recover from a retry storm)",
  "description": "Same as \"retry storm\", plus a retry budget of 0.1: in the last 10 seconds, retries are at most 10% of first calls. API load during a spike drops from about 14× to about 4×, and recovers about 3 s after the spike ends. Deadline propagation alone does not help: each hop timeout (150 ms) is already shorter than the deadline (1 s).",
  "nodes": [
    { "id": "users", "kind": "client", "pos": [0, 200] },
    {
      "id": "lb",
      "kind": "load_balancer",
      "label": "Load balancer",
      "pos": [300, 200],
      "params": { "policy": "least_conn" }
    },
    {
      "id": "api",
      "kind": "service",
      "label": "API server",
      "pos": [590, 200],
      "params": { "instances": 3, "concurrency": 4, "serviceMs": { "mean": 6, "cv": 1 } }
    },
    {
      "id": "cache",
      "kind": "cache",
      "label": "Redis",
      "pos": [920, 80],
      "params": { "hitRatio": 0.85 }
    },
    {
      "id": "db",
      "kind": "database",
      "label": "Postgres",
      "pos": [920, 320],
      "params": { "replicas": 1, "connections": 12 }
    }
  ],
  "edges": [
    { "from": "users", "to": "lb" },
    {
      "from": "lb",
      "to": "api",
      "timeoutMs": 150,
      "retries": 3,
      "backoffMs": 10,
      "retryBudget": 0.1
    },
    {
      "from": "api",
      "to": "cache",
      "timeoutMs": 150,
      "retries": 3,
      "backoffMs": 10,
      "retryBudget": 0.1
    },
    {
      "from": "api",
      "to": "db",
      "timeoutMs": 150,
      "retries": 3,
      "backoffMs": 10,
      "retryBudget": 0.1
    }
  ]
}
