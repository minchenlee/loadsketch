{
  "schema": "loadsketch/design@1",
  "name": "Quota per tenant",
  "description": "SaaS API: a large customer sends 9× the traffic of a small one. The rate limiter gives each user (tenant) its own quota, at most 500 per second and 40 in flight. A large customer over quota only blocks itself; small customers are not affected. Change how the quota is split to one shared quota and watch small customers get blocked too.",
  "nodes": [
    {
      "id": "big",
      "kind": "client",
      "label": "Large customer",
      "pos": [0, 100],
      "params": { "weight": 9 }
    },
    {
      "id": "small",
      "kind": "client",
      "label": "Small customer",
      "pos": [0, 300],
      "params": { "weight": 1 }
    },
    {
      "id": "rl",
      "kind": "rate_limiter",
      "label": "Per-tenant rate limit",
      "pos": [320, 200],
      "params": {
        "limit": "both",
        "ratePerSec": 500,
        "burst": 50,
        "maxConcurrent": 40,
        "scope": "per_client"
      }
    },
    {
      "id": "api",
      "kind": "service",
      "label": "API server",
      "pos": [640, 200],
      "params": { "instances": 4, "concurrency": 32 }
    },
    {
      "id": "db",
      "kind": "database",
      "label": "Postgres",
      "pos": [960, 200],
      "params": { "connections": 40 }
    }
  ],
  "edges": [
    { "from": "big", "to": "rl" },
    { "from": "small", "to": "rl" },
    { "from": "rl", "to": "api" },
    { "from": "api", "to": "db" }
  ]
}
