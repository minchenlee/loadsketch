{
  "schema": "loadsketch/design@1",
  "name": "快取擊穿（熱門 key 過期）",
  "description": "cache-aside：API 先查 Redis，沒命中才查 Postgres，再寫回 Redis。TTL 10 秒。最熱門的 key 每秒約 1,000 次讀取，Postgres 查一次要 100 ms、只有 16 個連線。熱門 key 一過期，查 DB 的 100 ms 內所有讀取都沒命中，上百個請求一起去查同一筆資料，DB 排隊、API 跟著滿載，約 7% 的請求失敗。對照「快取 lease＋TTL jitter」範例。",
  "nodes": [
    { "id": "users", "kind": "client", "pos": [0, 200] },
    { "id": "lb", "kind": "load_balancer", "label": "負載平衡器", "pos": [300, 200] },
    {
      "id": "api",
      "kind": "service",
      "label": "API 伺服器",
      "pos": [600, 200],
      "params": {
        "instances": 4,
        "concurrency": 64,
        "serviceMs": { "mean": 5, "cv": 1 },
        "queueLimit": 200
      }
    },
    {
      "id": "redis",
      "kind": "cache",
      "label": "Redis",
      "pos": [940, 60],
      "params": { "mode": "lru", "capacityKeys": 2000, "ttlS": 10, "concurrency": 64 }
    },
    {
      "id": "db",
      "kind": "database",
      "label": "Postgres",
      "pos": [940, 340],
      "params": {
        "replicas": 0,
        "connections": 16,
        "readMs": { "mean": 100, "cv": 0.5 },
        "queueLimit": 300
      }
    }
  ],
  "edges": [
    { "from": "users", "to": "lb" },
    { "from": "lb", "to": "api" },
    { "from": "api", "to": "redis" },
    { "from": "api", "to": "db" }
  ]
}
