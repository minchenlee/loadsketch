{
  "schema": "loadsketch/design@1",
  "name": "Short link redirect: read-heavy, LRU cache (after Bitly)",
  "description": "In a short-link service, each link is created once and then clicked thousands of times, so traffic is almost all reads (look up the code → original URL). This model uses an LRU cache to keep hot short links, and goes to the database replica only on a miss. The point: cache size and how hot the data is set the hit rate, and the hit rate sets how much the database must carry.",
  "nodes": [
    { "id": "users", "kind": "client", "label": "People who click short links", "pos": [0, 200] },
    { "id": "lb", "kind": "load_balancer", "label": "Load balancer", "pos": [270, 200] },
    {
      "id": "api",
      "kind": "service",
      "label": "Redirect API",
      "pos": [540, 200],
      "params": { "instances": 4, "concurrency": 32, "serviceMs": { "mean": 2, "cv": 1 } }
    },
    {
      "id": "cache",
      "kind": "cache",
      "label": "Redis (short code → URL)",
      "pos": [810, 80],
      "params": { "mode": "lru", "capacityKeys": 20000, "instances": 2, "concurrency": 16 }
    },
    {
      "id": "db",
      "kind": "database",
      "label": "URL database",
      "pos": [810, 320],
      "params": {
        "replicas": 1,
        "connections": 8,
        "readMs": { "mean": 5, "cv": 1 },
        "writeMs": { "mean": 8, "cv": 1 }
      }
    }
  ],
  "edges": [
    { "from": "users", "to": "lb" },
    { "from": "lb", "to": "api" },
    { "from": "api", "to": "cache" },
    { "from": "api", "to": "db", "timeoutMs": 300 }
  ]
}
