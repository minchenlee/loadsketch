{
  "schema": "loadsketch/design@1",
  "name": "Slow downstream: timeout, retry, circuit breaker",
  "description": "The order service calls the payment service. If the payment service slows down and there is no timeout and no circuit breaker, the order service threads get stuck and the whole site slows down with it.",
  "nodes": [
    { "id": "users", "kind": "client", "pos": [0, 200] },
    { "id": "lb", "kind": "load_balancer", "label": "Load balancer", "pos": [270, 200] },
    {
      "id": "orders",
      "kind": "service",
      "label": "Order service",
      "pos": [540, 200],
      "params": { "instances": 2, "concurrency": 16, "serviceMs": { "mean": 3, "cv": 1 } }
    },
    { "id": "cb", "kind": "circuit_breaker", "label": "Circuit breaker", "pos": [840, 200] },
    {
      "id": "payments",
      "kind": "service",
      "label": "Payment service",
      "pos": [1130, 200],
      "params": { "instances": 2, "concurrency": 32, "serviceMs": { "mean": 20, "cv": 0.5 } }
    },
    { "id": "db", "kind": "database", "label": "Order database", "pos": [840, 360] }
  ],
  "edges": [
    { "from": "users", "to": "lb" },
    { "from": "lb", "to": "orders" },
    { "from": "orders", "to": "db" },
    { "from": "orders", "to": "cb", "on": "write" },
    { "from": "cb", "to": "payments", "timeoutMs": 200, "retries": 1, "backoffMs": 50 }
  ]
}
