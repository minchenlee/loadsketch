{
  "schema": "loadsketch/design@1",
  "name": "Three-tier site (cache + read replicas)",
  "description": "The most common starting point: the load balancer spreads requests over 3 API servers; reads check the cache first (cache-aside) and go to the database replica only on a miss; writes go to the primary, then the cache is invalidated.",
  "nodes": [
    { "id": "users", "kind": "client", "pos": [0, 200] },
    {
      "id": "lb",
      "kind": "load_balancer",
      "label": "Load balancer",
      "pos": [300, 200],
      "params": { "policy": "least_conn" }
    },
    {
      "id": "api",
      "kind": "service",
      "label": "API server",
      "pos": [590, 200],
      "params": { "instances": 3, "concurrency": 4, "serviceMs": { "mean": 6, "cv": 1 } }
    },
    {
      "id": "cache",
      "kind": "cache",
      "label": "Redis",
      "pos": [920, 80],
      "params": { "hitRatio": 0.85 }
    },
    {
      "id": "db",
      "kind": "database",
      "label": "Postgres",
      "pos": [920, 320],
      "params": { "replicas": 1, "connections": 12 }
    }
  ],
  "edges": [
    { "from": "users", "to": "lb" },
    { "from": "lb", "to": "api" },
    { "from": "api", "to": "cache" },
    { "from": "api", "to": "db", "timeoutMs": 500 }
  ]
}
