{
  "schema": "loadsketch/design@1",
  "name": "Async processing after upload (queue + worker)",
  "description": "The API saves the upload to object storage, puts one message on the queue and responds; a worker takes the message and works slowly (for example, makes a thumbnail), then writes back to the database.",
  "nodes": [
    { "id": "users", "kind": "client", "pos": [0, 200] },
    { "id": "gw", "kind": "api_gateway", "label": "API Gateway", "pos": [270, 200] },
    {
      "id": "api",
      "kind": "service",
      "label": "Upload API",
      "pos": [540, 200],
      "params": { "instances": 2, "concurrency": 16 }
    },
    { "id": "blob", "kind": "object_storage", "label": "S3", "pos": [840, 60] },
    { "id": "jobs", "kind": "queue", "label": "Work queue", "pos": [840, 240] },
    {
      "id": "thumb",
      "kind": "worker",
      "label": "Thumbnail worker",
      "pos": [1130, 240],
      "params": { "instances": 2, "concurrency": 4, "serviceMs": { "mean": 40, "cv": 0.5 } }
    },
    { "id": "db", "kind": "database", "label": "Postgres", "pos": [1430, 240] }
  ],
  "edges": [
    { "from": "users", "to": "gw" },
    { "from": "gw", "to": "api" },
    { "from": "api", "to": "blob", "on": "write" },
    { "from": "api", "to": "jobs", "on": "write" },
    { "from": "api", "to": "db", "on": "read" },
    { "from": "jobs", "to": "thumb" },
    { "from": "thumb", "to": "db" }
  ]
}
