{
  "schema": "loadsketch/design@1",
  "name": "The CDN absorbs the traffic of a new release (after Netflix)",
  "description": "Netflix puts videos ahead of time on Open Connect cache appliances inside ISP sites, so most bytes of a stream never go back to AWS. This model puts the CDN first; only a miss goes back to the origin service and object storage. The point: CDN hit rate decides how much the origin must carry, and traffic spikes land mostly on the CDN.",
  "nodes": [
    { "id": "viewers", "kind": "client", "label": "Viewers", "pos": [0, 200] },
    {
      "id": "cdn",
      "kind": "cdn",
      "label": "Open Connect (CDN)",
      "pos": [270, 200],
      "params": { "hitRatio": 0.95, "edgeMs": { "mean": 5, "cv": 0.5 } }
    },
    { "id": "lb", "kind": "load_balancer", "label": "Origin load balancer", "pos": [540, 200] },
    {
      "id": "origin",
      "kind": "service",
      "label": "Origin service",
      "pos": [810, 200],
      "params": {
        "instances": 2,
        "concurrency": 32,
        "serviceMs": { "mean": 10, "cv": 1 },
        "queueLimit": 200
      }
    },
    {
      "id": "s3",
      "kind": "object_storage",
      "label": "S3 (video files)",
      "pos": [1080, 200],
      "params": { "getMs": { "mean": 40, "cv": 0.6 }, "concurrency": 400 }
    }
  ],
  "edges": [
    { "from": "viewers", "to": "cdn" },
    { "from": "cdn", "to": "lb", "latencyMs": 30 },
    { "from": "lb", "to": "origin" },
    { "from": "origin", "to": "s3" }
  ]
}
