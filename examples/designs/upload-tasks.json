{
  "schema": "loadsketch/design@1",
  "name": "Upload + async jobs: a slow dependency on the sync path (after Dropbox)",
  "description": "Dropbox's ATF lets teams schedule background jobs: the front end receives a request, writes it to job storage, then hands it to an executor through a queue with at-least-once execution. In this model the upload API writes to object storage synchronously, then puts a job on the queue; the executor processes it and writes back to the database. The point: a slow dependency on the sync path blocks the front end; a slow async path only makes the job finish later.",
  "nodes": [
    { "id": "users", "kind": "client", "label": "Users", "pos": [0, 200] },
    { "id": "gw", "kind": "api_gateway", "label": "API Gateway", "pos": [270, 200] },
    {
      "id": "api",
      "kind": "service",
      "label": "Upload API",
      "pos": [540, 200],
      "params": {
        "instances": 2,
        "concurrency": 32,
        "serviceMs": { "mean": 5, "cv": 1 },
        "queueLimit": 300
      }
    },
    {
      "id": "blob",
      "kind": "object_storage",
      "label": "Object storage (file blocks)",
      "pos": [810, 60],
      "params": { "putMs": { "mean": 60, "cv": 0.6 }, "getMs": { "mean": 30, "cv": 0.6 } }
    },
    { "id": "tasks", "kind": "queue", "label": "Job queue (SQS)", "pos": [810, 340] },
    {
      "id": "exec",
      "kind": "worker",
      "label": "Executor",
      "pos": [1080, 340],
      "params": { "instances": 4, "concurrency": 8, "serviceMs": { "mean": 50, "cv": 1 } }
    },
    {
      "id": "meta",
      "kind": "database",
      "label": "Metadata database",
      "pos": [1350, 200],
      "params": { "replicas": 1, "connections": 16 }
    }
  ],
  "edges": [
    { "from": "users", "to": "gw" },
    { "from": "gw", "to": "api" },
    { "from": "api", "to": "blob", "on": "write", "timeoutMs": 2000 },
    { "from": "api", "to": "tasks", "on": "write" },
    { "from": "api", "to": "meta", "on": "read" },
    { "from": "tasks", "to": "exec" },
    { "from": "exec", "to": "meta" }
  ]
}
