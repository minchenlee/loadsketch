{
  // The site is static files: `npm run build` writes dist/, and Cloudflare serves it.
  // Deploy: npm run deploy
  "name": "loadsketch",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist"
  },
  "routes": [{ "pattern": "loadsketch.mclee.dev", "custom_domain": true }]
}
